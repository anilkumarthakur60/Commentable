includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 9

    paths:
        - src/
        - config/
        - migrations/

    tips:
        treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # Traits used only by host models — not analysed standalone
        - '#Trait .* is used zero times and is not analysed#'
        # Builder::whereHas closure param is non-generic in Larastan
        - '#Parameter \#1 \$callback of method Illuminate\\Database\\Eloquent\\Builder.*whereHas.*#'
