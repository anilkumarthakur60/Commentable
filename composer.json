{
    "name": "anil/comments",
    "description": "A Laravel package providing a full-featured, multi-UI-framework commenting system for any Eloquent model.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5",
        "erusev/parsedown": "^1.7",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/pagination": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/laravel-honeypot": "^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "larastan/larastan": "^3.0|^4.0",
        "pestphp/pest": "^2.0|^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Anil\\Comments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Anil\\Comments\\Tests\\": "tests"
        }
    },
    "authors": [
        {
            "name": "Anil",
            "email": "anilkumarthakur60@gmail.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Anil\\Comments\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "pest": "vendor/bin/pest --parallel",
        "pest-coverage": "vendor/bin/pest --coverage",
        "pest-type": "vendor/bin/pest --type-coverage",
        "pint": "vendor/bin/pint",
        "phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon.dist"
    }
}
