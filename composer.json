{
    "name": "anil/comments",
    "description": "A Laravel package providing a full-featured, framework-agnostic commenting system for any Eloquent model.",
    "keywords": [
        "laravel",
        "comments",
        "commenting",
        "threaded-comments",
        "reactions",
        "polymorphic",
        "eloquent"
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5",
        "erusev/parsedown": "^1.7",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/pagination": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/laravel-honeypot": "^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0|^4.0",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "phpunit/phpcov": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Anil\\Comments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Anil\\Comments\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Anil",
            "email": "anilkumarthakur60@gmail.com",
            "role": "Developer"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Anil\\Comments\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage",
        "test:types": "vendor/bin/pest --type-coverage",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --configuration=phpstan.neon.dist",
        "analyse:memory": "vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --memory-limit=512M",
        "ci": [
            "@lint:check",
            "@analyse",
            "@test"
        ]
    }
}
