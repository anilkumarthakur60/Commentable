{
  "name": "anil/comments",
  "type": "library",
  "license": "MIT",
  "require": {
    "erusev/parsedown": "^1.7",
    "illuminate/database": "^11.0|^12.0",
    "illuminate/http": "^11.0|^12.0",
    "illuminate/pagination": "^11.0|^12.0",
    "illuminate/routing": "^11.0|^12.0",
    "illuminate/queue": "^11.0|^12.0",
    "illuminate/support": "^11.0|^12.0",
    "spatie/laravel-honeypot": "^4.0"
  },
  "require-dev": {
    "laravel/pint": "^1.22",
    "larastan/larastan": "^1.0|^2.0|^3.0",
    "orchestra/testbench": "^9.0|^10.0",
    "phpstan/phpstan": "^2.0|^3.0",
    "pestphp/pest": "^2.0||^3.0"
  },
  "autoload": {
    "psr-4": {
      "Anil\\Comments\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Anil",
      "email": "anilkumarthakur60@gmail.com"
    }
  ],
  "extra": {
    "laravel": {
      "providers": [
        "Anil\\Comments\\ServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Anil\\Comments\\Tests\\": "tests"
    }
  },
  "scripts": {
    "pest": "vendor/bin/pest --parallel",
    "pest-coverage": "vendor/bin/pest --coverage",
    "pest-type": "vendor/bin/pest --type-coverage",
    "pint": "vendor/bin/pint"
  }
}
